PORT=5000
NODE_ENV=development

# MongoDB — REQUIRED (server will not start without a successful connection)
# Encode special characters in password: @ → %40  # → %23  : → %3A
# Example: mongodb+srv://USER:PASS%40123@cluster0.xxxxx.mongodb.net/esamadhan?retryWrites=true&w=majority
# Primary (SRV) — from Atlas "Drivers" connection string
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/esamadhan?retryWrites=true&w=majority&appName=Cluster0

# Fallback if you see querySrv ECONNREFUSED — use Atlas "Standard" connection string (mongodb:// not mongodb+srv://)
# MONGO_URI_STANDARD=mongodb://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net:27017/esamadhan?retryWrites=true&w=majority

# Local MongoDB (optional dev)
# MONGO_URI=mongodb://127.0.0.1:27017/esamadhan

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Email (for forgot password + officer welcome)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@esamadhan.gov.in
FROM_NAME=e-Samadhan AI

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: require this value in POST /api/admin/register body as registerSecret (leave unset for open dev registration)
# ADMIN_REGISTER_SECRET=your_org_registration_key

# ── Temporary Development Database System ─────────────────────────────────────
# Set to true to wipe ALL collections on every server startup (development only)
# Set to false (or omit) to keep data between restarts
# NEVER set to true in production — production is always protected regardless
DEV_RESET_DATABASE=true

# Legacy clear flag (kept for compatibility — prefer DEV_RESET_DATABASE)
# AUTO_CLEAR_DB=true
# CLEAR_COLLECTIONS=users,complaints

# Liveness — development helpers
# DISABLE_LIVENESS_RATE_LIMIT=true
# AUTO_RESET_LIVENESS=true
